# Frontend environment template. Vite only exposes vars prefixed with VITE_,
# and every VITE_ var is inlined into the browser bundle (so it is PUBLIC).
# Restart the dev server after changing any env file.
#
# Convention (both .env and .env.local are gitignored):
#   .env         → non-secret local defaults, e.g. which backend to call
#   .env.local   → your keys and machine-specific overrides (loaded last, wins)
#
# Setup: copy the API line into `.env` and the key line into `.env.local`.
# In production, set these in your host's env dashboard instead of a file.

# --- .env (non-secret defaults) ---
# Backend API base URL. Leave unset to use bundled mock data.
VITE_API_URL=http://localhost:4000/api

# --- .env.local (your keys) ---
# Stripe PUBLISHABLE key (public — pk_test_... locally, pk_live_... in prod).
# https://dashboard.stripe.com/apikeys  |  blank = mock card form.
VITE_STRIPE_PUBLISHABLE_KEY=
