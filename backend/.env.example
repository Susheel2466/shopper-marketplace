# Copy to ".env" and adjust as needed.

PORT=4000

# Local MongoDB. For MongoDB Atlas use the full SRV connection string.
MONGO_URI=mongodb://127.0.0.1:27017/shopper

# Secret used to sign JWTs. MUST be a long random string (>= 32 chars).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production with a weak/placeholder value.
JWT_SECRET=change-this-to-a-long-random-secret
# Session length without "remember me", and with it.
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d

# Set to "production" on your live server (enables strict JWT-secret check).
NODE_ENV=development

# Allowed CORS origin(s). Comma-separate multiple, e.g. https://shop.com,https://www.shop.com
CLIENT_URL=http://localhost:3000

# Admin account created by `npm run seed`.
ADMIN_EMAIL=admin@shopper.com
ADMIN_PASSWORD=admin123

# Stripe. Leave blank to use the built-in MOCK payment processor.
# Test keys come from https://dashboard.stripe.com/test/apikeys
# To go LIVE later, just swap these for your live keys (sk_live_... / pk_live_...).
STRIPE_SECRET_KEY=
# Optional: only needed if you verify webhook signatures (stripe listen / dashboard)
STRIPE_WEBHOOK_SECRET=

# Email (SMTP). Leave blank to just log emails to the console in dev.
# For real email use a provider (Gmail App Password, SendGrid, Mailgun, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SHOPPER <no-reply@shopper.test>

# Search — set to use Meilisearch instead of MongoDB regex search.
# docker run -d -p 7700:7700 -e MEILI_MASTER_KEY=devkey getmeili/meilisearch
# then: npm run index
MEILI_HOST=
MEILI_KEY=

# Error tracking (optional) — Sentry DSN. Leave blank to disable.
SENTRY_DSN=
LOG_LEVEL=info

# Cache — in-memory by default. Set REDIS_URL to use Redis (survives restarts,
# shared across instances). Requires: npm i ioredis
REDIS_URL=

# Courier — rule-based ETA + synthetic tracking by default. Set the provider
# and credentials to call the real courier (uses global fetch, no dep needed).
# Verify Shiprocket's request/response fields against your account on first use.
COURIER_PROVIDER=            # "shiprocket" to enable, blank = rule-based
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
COURIER_PICKUP_PINCODE=560001
COURIER_PICKUP_NAME=Primary  # the pickup location name in your Shiprocket account

# Image storage — local disk by default (public/images). Set CLOUDINARY_URL to
# store on Cloudinary's CDN (required once deployed — hosted disks are wiped on
# redeploy). Requires: npm i cloudinary. Copy the URL verbatim from the
# dashboard: cloudinary://<key>:<secret>@<cloud_name>
CLOUDINARY_URL=
